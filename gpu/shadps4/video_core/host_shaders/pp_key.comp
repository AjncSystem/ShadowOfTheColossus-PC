#version 450

// sotc: the scene's key for the HDR picture controls (post_process.frag grade()): the log-average
// luminance of a 64x64 grid of samples, relative to the paper white, smoothed over time. SotC's
// frames go from ~3% of the paper white (night) to ~140% (desert noon); contrast, shadows and
// highlights pivot on this instead of a fixed mid grey, so they shape every scene alike.

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D scene;
layout(binding = 1) buffer Key {
    float log2_key; // log2 of the key / paper white
} key;

layout(push_constant) uniform Params {
    // 0: DLSS scene (linear, ^curve, 1.0 = 3x paper white); 1: the game's PQ frame; 2: an SDR
    // frame (linear, white 1); 3: an SDR frame still sRGB encoded
    uint mode;
    float curve; // mode 0: exponent of the game's HDR composite
    float alpha; // blend towards this frame's value (1: take it as is)
    float pad;
} pc;

const mat3 rec709to2020 = mat3(0.6274, 0.0691, 0.0164, 0.3293, 0.9195, 0.0880, 0.0433, 0.0114, 0.8956);
const vec3 luma2020 = vec3(0.2627, 0.6780, 0.0593);
const float m1 = 0.1593017578125, m2 = 78.84375, c1 = 0.8359375, c2 = 18.8515625, c3 = 18.6875;

float relativeLuma(vec3 c) {
    if (pc.mode == 0u) {
        return 3.0 * dot(rec709to2020 * pow(abs(c), vec3(pc.curve)), luma2020);
    }
    if (pc.mode >= 2u) {
        c = clamp(c, 0.0, 1.0);
        if (pc.mode == 3u) {
            c = mix(pow((c + 0.055) / 1.055, vec3(2.4)), c / 12.92, lessThan(c, vec3(0.04045)));
        }
        return dot(rec709to2020 * c, luma2020);
    }
    const vec3 p = pow(clamp(c, 0.0, 1.0), vec3(1.0 / m2));
    const vec3 nits = 10000.0 * pow(max(p - c1, 0.0) / (c2 - c3 * p), vec3(1.0 / m1));
    return dot(nits, luma2020) / 100.0; // the game's white is ~100 nits
}

shared float sums[256];

void main() {
    const uvec2 cell = gl_LocalInvocationID.xy;
    float sum = 0.0;
    for (uint j = 0u; j < 4u; ++j) {
        for (uint i = 0u; i < 4u; ++i) {
            const vec2 uv = (vec2(cell * 4u + uvec2(i, j)) + 0.5) / 64.0;
            const float y = relativeLuma(textureLod(scene, uv, 0.0).rgb);
            // Floor at 0.1% of the paper white: black bars and pure black do not drag the key
            // down without end. Exponent bits instead of isnan() (drivers may assume no NaN).
            const bool bad = (floatBitsToUint(y) & 0x7f800000u) == 0x7f800000u;
            sum += log2(bad ? 1e-3 : max(y, 1e-3));
        }
    }
    sums[gl_LocalInvocationIndex] = sum;
    barrier();
    for (uint n = 128u; n > 0u; n >>= 1) {
        if (gl_LocalInvocationIndex < n) {
            sums[gl_LocalInvocationIndex] += sums[gl_LocalInvocationIndex + n];
        }
        barrier();
    }
    if (gl_LocalInvocationIndex == 0u) {
        const float frame = sums[0] / 4096.0;
        const float old = key.log2_key;
        const bool old_ok = (floatBitsToUint(old) & 0x7f800000u) != 0x7f800000u &&
                            old > -12.0 && old < 6.0;
        key.log2_key = (pc.alpha >= 1.0 || !old_ok) ? frame : mix(old, frame, pc.alpha);
    }
}
